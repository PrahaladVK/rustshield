{
  "productName": "RustShield",
  "version": "0.1.0",
  "identifier": "com.rustshield.security",
  "build": {
    "frontendDist":       "../dist",
    "devUrl":             "http://localhost:1420",
    "beforeDevCommand":   "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title":     "RustShield Security",
        "width":     1100,
        "height":    720,
        "minWidth":  900,
        "minHeight": 600,
        "center":    true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:7878; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost"
    }
  },
  "bundle": {
    "active":  true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
